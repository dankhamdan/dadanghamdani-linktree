DATABASE_URL=file:/home/z/my-project/db/custom.db

# ============================================================
# Midtrans Configuration
# ============================================================
# 1. Daftar di https://midtrans.com (gratis)
# 2. Settings → Access Keys → copy Server Key & Client Key
# 3. Sandbox mode untuk testing (pakai kartu/test VA dari Midtrans docs)
# 4. Production mode untuk live (ganti MIDTRANS_ENVIRONMENT=production
#    DAN pakai Server/Client Key versi Production)

MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY_HERE
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY_HERE
NEXT_PUBLIC_SITE_URL=https://nadyazahira.my.id
